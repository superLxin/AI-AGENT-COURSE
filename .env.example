# ========== 使用 Agnes-AI（免费，推荐）==========
OPENAI_API_KEY=sk-agnes-xxxxxxxx
OPENAI_BASE_URL=https://api.agnes-ai.cn/v1
OPENAI_MODEL=agnes-2.0-flash

# ========== 或者使用 DeepSeek（低价）==========
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-v4-flash

# ========== 或者使用 OpenAI ==========
# OPENAI_API_KEY=sk-xxxxxxxx
# （不需要设 OPENAI_BASE_URL，默认就是 OpenAI）
# OPENAI_MODEL=gpt-4o-mini

# ========== Embedding 模型（第 4/8/10 讲需要，可选）==========
# 默认 text-embedding-3-small（仅 OpenAI 支持），Agnes-AI/DeepSeek 不可用
# 代码会自动检测：API 不可用 → 降级为本地 all-MiniLM-L6-v2 模型
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
