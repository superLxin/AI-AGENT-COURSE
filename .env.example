# OpenAI API Key（也支持 Agnes-AI（免费）、DeepSeek 等兼容 API）
OPENAI_API_KEY=sk-your-key-here

# 如果使用非 OpenAI 的兼容 API，修改以下配置
# OPENAI_BASE_URL=https://api.agnesai.com/v1     # Agnes-AI（免费，推荐）
# OPENAI_BASE_URL=https://api.deepseek.com/v1     # DeepSeek（低价）

# LangFuse 可观测性（第 9 讲需要，可选）
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
